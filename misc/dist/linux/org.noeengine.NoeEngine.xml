<?xml version="1.0"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-noeengine-project">
    <comment>NoeEngine Engine project</comment>
    <sub-class-of type="text/plain"/>
    <icon name="x-noeengine-project"/>
    <glob pattern="project.noeengine"/>
  </mime-type>

  <mime-type type="application/x-noeengine-resource">
    <comment>NoeEngine Engine resource</comment>
    <icon name="x-noeengine-resource"/>
    <glob pattern="*.res"/>
    <glob pattern="*.tres"/>
  </mime-type>

  <mime-type type="application/x-noeengine-scene">
    <comment>NoeEngine Engine scene</comment>
    <icon name="x-noeengine-scene"/>
    <glob pattern="*.scn"/>
    <glob pattern="*.tscn"/>
    <glob pattern="*.escn"/>
  </mime-type>

  <mime-type type="application/x-noeengine-shader">
    <comment>NoeEngine Engine shader</comment>
    <sub-class-of type="text/plain"/>
    <icon name="x-noeengine-shader"/>
    <glob pattern="*.gdshader"/>
  </mime-type>

  <mime-type type="application/x-gdscript">
    <comment>GDScript script</comment>
    <sub-class-of type="text/plain"/>
    <icon name="x-gdscript"/>
    <glob pattern="*.gd"/>
  </mime-type>
</mime-info>
