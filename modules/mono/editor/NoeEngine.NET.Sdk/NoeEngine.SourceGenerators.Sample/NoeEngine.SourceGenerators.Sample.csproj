<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <!-- $(NoeEngineProjectDir) would normally be defined by the NoeEngine.NET.Sdk -->
    <NoeEngineProjectDir>$(MSBuildProjectDirectory)</NoeEngineProjectDir>
    <NoeEngineProjectDirBase64 Condition=" $([MSBuild]::VersionGreaterThanOrEquals($(MSBuildAssemblyVersion), '17.3')) ">$([MSBuild]::ConvertToBase64('$(NoeEngineProjectDir)'))</NoeEngineProjectDirBase64>
    <!-- For compiling GetNoeEnginePropertyDefaultValues. -->
    <DefineConstants>$(DefineConstants);TOOLS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The emitted files are not part of the compilation nor design.
    They're only for peeking at the generated sources. Sometimes the
    emitted files get corrupted, but that won't break anything. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\glue\NoeEngineSharp\NoeEngineSharp\NoeEngineSharp.csproj">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="..\NoeEngine.SourceGenerators\NoeEngine.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- This file is imported automatically when using PackageReference to
  reference NoeEngine.SourceGenerators, but not when using ProjectReference -->
  <Import Project="..\NoeEngine.SourceGenerators\NoeEngine.SourceGenerators.props" />

</Project>
