--- /dev/null
+++ b/main/noe_core_policy.h
@@ -0,0 +1,70 @@
+// NoeCore policy primitives. No engine types or allocation on the hot path.
+#ifndef NOE_CORE_POLICY_H
+#define NOE_CORE_POLICY_H
+
+#include <cstdint>
+#include <limits>
+
+namespace NoeCore {
+constexpr uint64_t GiB = 1024ULL * 1024 * 1024;
+
+enum class Profile { LOW, BALANCED, HIGH, ULTRA };
+struct Hardware {
+    uint32_t cpu_threads = 0;
+    uint64_t ram_bytes = 0;
+    uint64_t vram_bytes = 0; // 0 means unknown, NOT no VRAM.
+    bool hardware_gpu = false;
+    bool graphics_api_supported = false;
+};
+
+inline Profile recommend(const Hardware &h) {
+    // An unverified renderer is not evidence for selecting a costly preset.
+    if (!h.hardware_gpu || !h.graphics_api_supported) return Profile::LOW;
+    if (h.cpu_threads && h.cpu_threads < 4) return Profile::LOW;
+    if (h.ram_bytes && h.ram_bytes < 6 * GiB) return Profile::LOW;
+    if (!h.ram_bytes || !h.cpu_threads || !h.vram_bytes) return Profile::BALANCED;
+    if (h.cpu_threads >= 12 && h.ram_bytes >= 24 * GiB && h.vram_bytes >= 8 * GiB) return Profile::ULTRA;
+    if (h.cpu_threads >= 8 && h.ram_bytes >= 12 * GiB && h.vram_bytes >= 4 * GiB) return Profile::HIGH;
+    return h.vram_bytes < 2 * GiB ? Profile::LOW : Profile::BALANCED;
+}
+inline const char *profile_name(Profile p) {
+    switch (p) {
+        case Profile::LOW: return "Low";
+        case Profile::BALANCED: return "Balanced";
+        case Profile::HIGH: return "High";
+        case Profile::ULTRA: return "Ultra";
+    }
+    return "Low";
+}
+
+struct CacheEntry {
+    uint64_t size_bytes = 0;
+    uint64_t last_used_frame = 0;
+    uint32_t external_references = 0;
+    bool pinned = false;
+    bool in_active_scene = false;
+    bool loading = false;
+};
+
+class MemoryBudget {
+    uint64_t limit_bytes = 0;
+    uint64_t used_bytes = 0;
+public:
+    explicit MemoryBudget(uint64_t limit = 0) : limit_bytes(limit) {}
+    void set_limit(uint64_t limit) { limit_bytes = limit; }
+    uint64_t limit() const { return limit_bytes; }
+    uint64_t usage() const { return used_bytes; }
+    void account(uint64_t bytes) {
+        used_bytes = bytes > std::numeric_limits<uint64_t>::max() - used_bytes ?
+                std::numeric_limits<uint64_t>::max() : used_bytes + bytes;
+    }
+    void release(uint64_t bytes) { used_bytes = bytes > used_bytes ? 0 : used_bytes - bytes; }
+    bool over_budget() const { return limit_bytes && used_bytes > limit_bytes; }
+    bool may_evict(const CacheEntry &item, uint64_t now_frame, uint64_t grace_frames = 120) const {
+        return over_budget() && item.size_bytes != 0 && !item.pinned &&
+                !item.in_active_scene && !item.loading && !item.external_references &&
+                now_frame >= item.last_used_frame && now_frame - item.last_used_frame >= grace_frames;
+    }
+};
+} // namespace NoeCore
+#endif // NOE_CORE_POLICY_H
diff --git a/main/noe_profiler_analysis.h b/main/noe_profiler_analysis.h
new file mode 100644
index 00000000000..d9fcb2c1114
--- /dev/null
+++ b/main/noe_profiler_analysis.h
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: MIT
+// NoeProfiler's dependency-free frame-time analysis policy.
+// CPU profiler categories overlap: script time is nested in process time and
+// renderer/asset stalls cannot be inferred from CPU-only samples.
+#ifndef NOE_PROFILER_ANALYSIS_H
+#define NOE_PROFILER_ANALYSIS_H
+
+#include <cmath>
+
+namespace NoeProfiler {
+struct FrameSample {
+    double frame_seconds = 0.0;
+    double process_seconds = 0.0;
+    double physics_seconds = 0.0;
+    double script_seconds = 0.0;
+};
+
+enum class Bottleneck {
+    UNKNOWN,
+    PROCESS,
+    PHYSICS
+};
+
+struct FrameAnalysis {
+    bool valid = false;
+    bool is_spike = false;
+    double frame_ms = 0.0;
+    double process_ms = 0.0;
+    double physics_ms = 0.0;
+    double script_ms = 0.0;
+    // Lower bound: process and physics could overlap; GPU and stalls are not measured.
+    double unattributed_lower_bound_ms = 0.0;
+    Bottleneck largest_measured = Bottleneck::UNKNOWN;
+};
+
+inline double positive_ms(double seconds) {
+    return std::isfinite(seconds) && seconds > 0.0 ? seconds * 1000.0 : 0.0;
+}
+inline bool is_spike(double frame_seconds, double threshold_ms) {
+    return std::isfinite(threshold_ms) && threshold_ms > 0.0 &&
+            positive_ms(frame_seconds) >= threshold_ms;
+}
+inline FrameAnalysis analyze(const FrameSample &sample, double threshold_ms = 33.3) {
+    FrameAnalysis result;
+    if (!std::isfinite(sample.frame_seconds) || sample.frame_seconds <= 0.0) {
+        return result;
+    }
+    result.valid = true;
+    result.frame_ms = positive_ms(sample.frame_seconds);
+    result.process_ms = positive_ms(sample.process_seconds);
+    result.physics_ms = positive_ms(sample.physics_seconds);
+    result.script_ms = positive_ms(sample.script_seconds);
+    result.is_spike = is_spike(sample.frame_seconds, threshold_ms);
+    // Do not subtract nested script time twice. Do not invent a GPU duration.
+    result.unattributed_lower_bound_ms = result.frame_ms > (result.process_ms + result.physics_ms) ?
+            result.frame_ms - (result.process_ms + result.physics_ms) : 0.0;
+    if (result.process_ms > 0.0 || result.physics_ms > 0.0) {
+        result.largest_measured = result.process_ms >= result.physics_ms ? Bottleneck::PROCESS : Bottleneck::PHYSICS;
+    }
+    return result;
+}
+inline const char *bottleneck_name(Bottleneck kind) {
+    switch (kind) {
+        case Bottleneck::PROCESS: return "Process CPU";
+        case Bottleneck::PHYSICS: return "Physics CPU";
+        case Bottleneck::UNKNOWN: return "Unavailable";
+    }
+    return "Unavailable";
+}
+} // namespace NoeProfiler
+#endif // NOE_PROFILER_ANALYSIS_H
diff --git a/tests/noe_core_policy_test.cpp b/tests/noe_core_policy_test.cpp
new file mode 100644
index 00000000000..606c6dca074
--- /dev/null
+++ b/tests/noe_core_policy_test.cpp
@@ -0,0 +1,44 @@
+#include "main/noe_core_policy.h"
+#include <cassert>
+#include <limits>
+int main() {
+    using namespace NoeCore;
+    Hardware h;
+    assert(recommend(h) == Profile::LOW);
+    h = { 8, 16 * GiB, 4 * GiB, true, true };
+    assert(recommend(h) == Profile::HIGH);
+    h = { 16, 32 * GiB, 12 * GiB, true, true };
+    assert(recommend(h) == Profile::ULTRA);
+    h = { 8, 16 * GiB, 0, true, true };
+    assert(recommend(h) == Profile::BALANCED);
+    h = { 8, 16 * GiB, 8 * GiB, true, false };
+    assert(recommend(h) == Profile::LOW);
+    h = { 2, 32 * GiB, 8 * GiB, true, true };
+    assert(recommend(h) == Profile::LOW);
+    MemoryBudget budget(100);
+    CacheEntry item{ 60, 10, 0, false, false, false };
+    budget.account(101);
+    assert(budget.over_budget());
+    assert(!budget.may_evict(item, 129));
+    assert(budget.may_evict(item, 130));
+    item.in_active_scene = true;
+    assert(!budget.may_evict(item, 10000));
+    item.in_active_scene = false;
+    item.external_references = 1;
+    assert(!budget.may_evict(item, 10000));
+    item.external_references = 0;
+    item.pinned = true;
+    assert(!budget.may_evict(item, 10000));
+    item.pinned = false;
+    item.loading = true;
+    assert(!budget.may_evict(item, 10000));
+    item.loading = false;
+    budget.release(101);
+    assert(!budget.may_evict(item, 10000));
+    budget.account(std::numeric_limits<uint64_t>::max());
+    budget.account(42);
+    assert(budget.usage() == std::numeric_limits<uint64_t>::max());
+    budget.release(std::numeric_limits<uint64_t>::max());
+    assert(budget.usage() == 0);
+    return 0;
+}
diff --git a/tests/noe_profiler/compare.py b/tests/noe_profiler/compare.py
new file mode 100644
index 00000000000..eb366ed672e
--- /dev/null
+++ b/tests/noe_profiler/compare.py
@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+"""Compare NoeProfiler frame captures without silently mixing monitor and frame rows."""
+import argparse
+import csv
+import json
+import math
+from pathlib import Path
+import statistics
+import sys
+
+def read_frames(path):
+    with Path(path).open(newline="", encoding="utf-8-sig") as handle:
+        rows = csv.reader(handle)
+        columns = None
+        frames = []
+        for row in rows:
+            names = [cell.strip() for cell in row]
+            if "frame_number" in names and "frame_time_s" in names:
+                columns = {name: index for index, name in enumerate(names)}
+                continue
+            if columns is None or not row or not any(row):
+                continue
+            try:
+                value = row[columns["frame_time_s"]].strip()
+                sample_type = row[columns["sample_type"]].strip() if "sample_type" in columns else "frame"
+                if sample_type != "frame":
+                    continue
+                if not value:
+                    continue
+                milliseconds = float(value) * 1000.0
+                if math.isfinite(milliseconds) and milliseconds > 0:
+                    frames.append(milliseconds)
+            except (ValueError, IndexError):
+                # Ignore unrecognized CSV sections following the profiler table.
+                continue
+    if not frames:
+        raise ValueError(f"{path}: no valid individual frame samples in export")
+    return frames
+
+def percentile(sorted_values, q):
+    position = (len(sorted_values) - 1) * q
+    lo = int(math.floor(position))
+    hi = int(math.ceil(position))
+    return sorted_values[lo] + (sorted_values[hi] - sorted_values[lo]) * (position - lo)
+
+def summarize(frames, spike_ms):
+    ordered = sorted(frames)
+    return {
+        "frames": len(ordered),
+        "mean_ms": round(statistics.fmean(ordered), 4),
+        "p50_ms": round(percentile(ordered, 0.5), 4),
+        "p95_ms": round(percentile(ordered, 0.95), 4),
+        "p99_ms": round(percentile(ordered, 0.99), 4),
+        "max_ms": round(ordered[-1], 4),
+        "spikes": sum(value >= spike_ms for value in ordered),
+        "spike_threshold_ms": spike_ms,
+    }
+
+def compare(baseline, candidate, max_regression_pct=10.0, spike_ms=33.3, min_frames=5):
+    if min(len(baseline), len(candidate)) < min_frames:
+        raise ValueError(f"need at least {min_frames} frame samples in both captures")
+    a = summarize(baseline, spike_ms)
+    b = summarize(candidate, spike_ms)
+    percent = ((b["p95_ms"] / a["p95_ms"]) - 1.0) * 100.0
+    return {
+        "baseline": a,
+        "candidate": b,
+        "p95_regression_pct": round(percent, 4),
+        "max_p95_regression_pct": max_regression_pct,
+        "pass": percent <= max_regression_pct,
+    }
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("baseline", type=Path)
+    parser.add_argument("candidate", type=Path)
+    parser.add_argument("--max-p95-regression-pct", type=float, default=10.0)
+    parser.add_argument("--spike-ms", type=float, default=33.3)
+    parser.add_argument("--min-frames", type=int, default=5)
+    parser.add_argument("--json", type=Path, dest="json_path")
+    args = parser.parse_args(argv)
+    if not math.isfinite(args.max_p95_regression_pct) or args.max_p95_regression_pct < 0:
+        parser.error("--max-p95-regression-pct must be a finite nonnegative number")
+    if not math.isfinite(args.spike_ms) or args.spike_ms <= 0 or args.min_frames < 1:
+        parser.error("spike threshold and minimum frame count must be positive")
+    try:
+        report = compare(read_frames(args.baseline), read_frames(args.candidate),
+                         args.max_p95_regression_pct, args.spike_ms, args.min_frames)
+    except (OSError, ValueError) as exc:
+        parser.error(str(exc))
+    output = json.dumps(report, indent=2, sort_keys=True)
+    print(output)
+    if args.json_path:
+        args.json_path.write_text(output + "\n", encoding="utf-8")
+    return 0 if report["pass"] else 1
+
+if __name__ == "__main__":
+    sys.exit(main())
