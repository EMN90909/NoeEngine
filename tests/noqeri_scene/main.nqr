// Native .nqr lifecycle smoke for the NoeEngine ScriptLanguage bridge.
let ticks: int = 0

function _ready(): void {
    repeat 2 { print("NOQERI_REPEAT_STEP") }
    print("NOQERI_NATIVE_READY")
}

function _process(delta: float): void {
    ticks = ticks + 1
    if ticks >= 1 {
        print("NOQERI_NATIVE_PROCESS")
        get_tree().quit()
    }
}
